    %% =============================================
    %% CORE ENGINE - Primitive Types
    %% =============================================

    class Color {
        <<primitive>>
        uint8
    }

    class Position {
        +int X
        +int Y
        +Add(other Position) Position
        +Subtract(other Position) Position
        +WithX(x int) Position
        +WithY(y int) Position
    }

    class RGB {
        +uint32 value
        +RGB() (r, g, b uint8)
        +RGBf() (r, g, b float64)
        +FromRGB(r, g, b uint8) RGB
        +FromRGBf(r, g, b float64) RGB
    }

    %% =============================================
    %% CORE ENGINE - Generic Types
    %% =============================================

    class Area~T~ {
        +T X
        +T Y
        +T W
        +T H
        +Size() T
        +WithX(x T) Area~T~
        +WithY(y T) Area~T~
        +WithW(w T) Area~T~
        +WithH(h T) Area~T~
        +MovedBy(dx, dy T) Area~T~
        +ClippedBy(clip Area~T~) Area~T~
        +Contains(x, y T) bool
    }

    class IntArea {
        <<alias>>
    }
    IntArea --|> Area~int~

    class Surface~T~ {
        -[]T data
        -int width
        -int height
        +W() int
        +H() int
        +Set(x, y int, value T)
        +Get(x, y int) T
        +SetArea(area IntArea, values ...T)
        +Clone() Surface~T~
        +CloneArea(area IntArea) Surface~T~
        +Clear(v T)
        +LinesIterator(area IntArea) iter.Seq2
    }

    class Canvas {
        <<alias: Surface~Color~>>
    }
    Canvas --|> Surface~Color~

    %% =============================================
    %% CORE ENGINE - Sprite System
    %% =============================================

    class Sprite {
        +Area[int] Area
        +Source Canvas
        +FlipX bool
        +FlipY bool
        +WithFlipX(flip bool) Sprite
        +WithFlipY(flip bool) Sprite
        +WithSize(w, h int) Sprite
        +WithSizeScaled(w, h float64) Sprite
        +WithSource(source Canvas) Sprite
    }

    Sprite --> Canvas : source
    Sprite --|> Area[int] : embeds


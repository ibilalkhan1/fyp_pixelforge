    %% =============================================
    %% EVENT SYSTEM - Observer Pattern
    %% =============================================

    class Target~T~ {
        <<interface>>
        +Publish(event T)
        +Subscribe(event T, f func(T, Handler)) Handler
        +SubscribeAll(listener func(T, Handler)) Handler
        +Unsubscribe(handler Handler)
        +IsSubscribed(handler Handler) bool
        +SetTracing(enabled bool)
    }

    class Handler {
        <<type>>
        int
    }

    class target~T~ {
        <<private>>
        -handlers []eventHandler~T~
        -tracing bool
        -lastID Handler
    }

    class TrackingTarget~T~ {
        -wrappedTarget Target~T~
        -handlers []Handler
        +Publish(event T)
        +Subscribe(event T, f func(T, Handler)) Handler
        +SubscribeAll(listener func(T, Handler)) Handler
        +UnsubscribeAll()
    }

    Target~T~ <|.. target~T~ : implements
    Target~T~ <|.. TrackingTarget~T~ : implements
    TrackingTarget~T~ o-- Target~T~ : wraps
    target~T~ *-- eventHandler~T~ : contains

    class eventHandler~T~ {
        <<private>>
        -id Handler
        -fileLoc string
        -f func(T, Handler)
    }
    eventHandler~T~ --> Handler : identified by

    %% =============================================
    %% AUDIO SYSTEM
    %% =============================================

    class Sample {
        -[]int8 data
        -uint16 sampleRate
        +Data() []int8
        +Len() int
        +SampleRate() uint16
    }

    class LoopType {
        <<enumeration>>
        "none"
        "forward"
    }

    class BackendInterface {
        <<interface>>
        +LoadSample(sample *Sample)
        +UnloadSample(sample *Sample)
        +SetSample(ch Chan, sample *Sample, offset int, delay float64)
        +SetLoop(ch Chan, start int, length int, loopType LoopType, delay float64)
        +SetPitch(ch Chan, pitch float64, delay float64)
        +SetVolume(ch Chan, vol float64, delay float64)
        +ClearChan(ch Chan, delay float64)
    }

    class panicBackend {
        <<implements BackendInterface>>
    }

    BackendInterface <|.. panicBackend

    class AudioFunctions {
        <<global>>
        +LoadSample(sample *Sample)
        +Play(ch Chan, sample *Sample, pitch, vol float64)
        +SetPitch(ch Chan, pitch float64, delay float64)
        +SetVolume(ch Chan, vol float64, delay float64)
        +Time float64
    }

    AudioFunctions ..> BackendInterface : uses

    class Chan {
        <<type alias>>
        uint8
        Chan1 = 1
        Chan2 = 2
        Chan3 = 4
        Chan4 = 8
    }

    AudioFunctions ..> Sample : uses

